# ─────────────────────────────────────────────────────────────────────────────
#  Reflex Delivery Tracking System — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL Database (Local Setup) ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=reflex_tracker

# ── MySQL Database (Railway Setup) ────────────────────────
# Option 1: Full connection URL provided by Railway
# MYSQL_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway
# Option 2: Railway individual variables
# MYSQLHOST=roundhouse.proxy.rlwy.net
# MYSQLPORT=12345
# MYSQLUSER=root
# MYSQLPASSWORD=your_railway_password
# MYSQLDATABASE=railway

# ── Test Database (used only when NODE_ENV=test) ──────────
DB_NAME_TEST=reflex_tracker_test

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File Uploads ──────────────────────────────────────────
UPLOAD_DIR=uploads/proof
MAX_FILE_SIZE_MB=5
