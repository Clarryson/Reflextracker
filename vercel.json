{
  "rewrites": [
    {
      "source": "/api-proxy/:path*",
      "destination": "https://backend-production-7f0d0.up.railway.app/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://backend-production-7f0d0.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
